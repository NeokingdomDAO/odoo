<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="neok_pot_view_users_form_mod" model="ir.ui.view">
        <field name="name">neok_pot_view_users_form_mod</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='preferences']//group[1]" position="after">
                <group name="neok_based_preferences">
                    <group string="Project management" name="project_management">
                        <field name="show_pot" widget="boolean_toggle"/>
                    </group>
                    <group/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="neok_pot_view_users_form_simple_modif_mod" model="ir.ui.view">
        <field name="name">neok_pot_view_users_form_simple_modif_mod</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='preferences']" position="after">
                <group name="neok_based_preferences">
                    <group string="Project management" name="project_management">
                        <field name="show_pot" widget="boolean_toggle"/>
                    </group>
                    <group/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
