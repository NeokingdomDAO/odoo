<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="previously_opened_tasks.Renderer" owl="1">
        <div t-if="this.sShowPrevTasksBar" class="neok-prev-opened-tasks-container">
            <button class="neok-pot-prev-btn" t-on-click="()=> { this.scrollNeokPotContainer('prev'); }"
                    tabindex="0" data-bs-toggle="tooltip" title="Previous"
            >
                <svg version="1.1" id="icons_1_" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 128 128" style="enable-background:new 0 0 128 128"><style>.st0{display:none}.st1{display:inline}.st2{fill:#0a0a0a}</style><g id="row2_1_"><g id="_x31__4_"><path class="st2" d="M64 .3C28.7.3 0 28.8 0 64s28.7 63.7 64 63.7 64-28.5 64-63.7S99.3.3 64 .3zm0 121C32.2 121.3 6.4 95.7 6.4 64 6.4 32.3 32.2 6.7 64 6.7s57.6 25.7 57.6 57.3c0 31.7-25.8 57.3-57.6 57.3zm1.3-82.8L41.6 64l23.6 25.5h13.5L54.4 64l24.4-25.5H65.3z" id="left_3_"/></g></g></svg>
            </button>
            <div class="neok-pot-chip-container" tabindex="0" data-bs-toggle="tooltip" title="Previously opened tasks.">
                <div t-foreach="this.resTasks" t-as="chipFilter" t-key="chipFilter.id"
                     t-on-click="()=> { this.openTaskByNeokChip(chipFilter.id); }"
                     class="neok-pot-chip">
                    <span t-esc="chipFilter.name" tabindex="0" data-bs-toggle="tooltip" t-att-title="chipFilter.name"/>
                </div>
            </div>
            <button class="neok-pot-next-btn" t-on-click="()=> { this.scrollNeokPotContainer('next'); }"
                    tabindex="0" data-bs-toggle="tooltip" title="Next"
            >
                <svg version="1.1" id="icons_1_" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 128 128" style="enable-background:new 0 0 128 128"><style>.st0{display:none}.st1{display:inline}.st2{fill:#0a0a0a}</style><g id="row1_1_"><g id="_x31__3_"><path class="st2" d="M64 0C28.7 0 0 28.7 0 64s28.7 64 64 64 64-28.7 64-64S99.3 0 64 0zm0 121.6C32.2 121.6 6.4 95.8 6.4 64S32.2 6.4 64 6.4s57.6 25.8 57.6 57.6-25.8 57.6-57.6 57.6zM49.2 38.4 73.6 64 49.2 89.6h13.5L86.4 64 62.7 38.4H49.2z" id="_x32__2_"/></g></g></svg>
            </button>
        </div>
    </t>

</templates>