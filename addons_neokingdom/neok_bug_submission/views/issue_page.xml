<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="issue_page" name="Issue Page">
        <t t-call="web.layout">
            <t t-set="title">Report Issue</t>

            <t t-set="head_web">
                <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
                <!-- Chrome, Firefox OS and Opera -->
                <meta name="theme-color" content="#f01363"/>
                <link rel="icon" sizes="192x192" href="/web/static/img/mobile-icons/android-192x192.png"/>

                <!-- iOS Safari -->
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
                <link rel="apple-touch-icon" href="/web/static/img/mobile-icons/apple-152x152.png"/>

                <!-- Windows Phone -->
                <meta name="msapplication-navbutton-color" content="#875A7B"/>
                <meta name="msapplication-TileColor" content="#875A7B"/>
                <meta name="msapplication-TileImage" content="/web/static/img/mobile-icons/windows-144x144.png"/>
            </t>
            <t t-set="head" t-value="head_web + (head or '')"/>

            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
                  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
                  crossorigin="anonymous"/>
            <link href="/neok_bug_submission/static/src/css/issue_page.css" rel="stylesheet"/>

            <div class="issue-page-container">
                <input type="hidden" id="recaptcha-site-key" t-att-value="recaptcha_site_key"/>

                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-10 title text-center">
                            <img src="/neok_bug_submission/static/src/img/neok_logo.png" alt="NEOKingdom Logo"/>
                            <h1>Are you having trouble?</h1>
                            <h2>Unacceptable! Let's fix it.</h2>
                        </div>
                    </div>
                    <div class="row justify-content-center body-container">
                        <div class="col-10 body text-center">

                            <div class="mt-4 pt-4 d-flex flex-column flex-lg-row align-items-md-stretch justify-content-md-center gap-3 mb-4">
                                <a href="https://rabbithole.neokingdom.org" target="_new"
                                   class="issue-btn btn btn-lg btn-lg btn-primary fw-semibold">
                                    Show me the FAQs
                                </a>
                                <a id="report-bug-btn" href="#"
                                   class="issue-btn btn btn-lg btn-lg btn-primary fw-semibold">
                                    I want to report a bug
                                </a>
                            </div>
                            <div class="mb-5 pb-5 d-flex flex-column flex-lg-row align-items-md-stretch justify-content-md-center gap-3 mb-4">
                                <a href="mailto:info@neokingdom.org"
                                   class="issue-btn btn btn-lg btn-lg btn-primary fw-semibold">
                                    I have question(s) - Let's talk
                                </a>
                            </div>

                        </div>
                        <div class="col-12 report-bug-body text-center my-5">
                            <form id="report-bug-form" action="/issue/submit" method="post" enctype="multipart/form-data">
                                <div class="mb-4">
                                    <h2>Report a Bug</h2>
                                </div>
                                <div class="mb-4">
                                    <label for="inputName" class="form-label">Your Name*</label>
                                    <input type="text" name="name" class="form-control" id="inputName"
                                           t-att-value="name" aria-describedby="text" required="true"/>
                                </div>
                                <div class="mb-4">
                                    <label for="inputEmail" class="form-label">Email address*</label>
                                    <input type="email" name="email" class="form-control" id="inputEmail"
                                           t-att-value="email" aria-describedby="emailHelp" required="true"/>
                                    <div id="emailHelp" class="form-text" style="font-size:.95rem;">
                                        We'll never share your email with anyone else.</div>
                                </div>
                                <div class="mb-4">
                                    <label for="inputDaoName" class="form-label">Your DAO's Name*</label>
                                    <input type="text" t-att-value="dao_name" name="dao_name" class="form-control"
                                           id="inputDaoName" aria-describedby="text" required="true"/>
                                </div>
                                <div class="mb-4">
                                    <label for="inputTitle" class="form-label">Question / Issue Title*</label>
                                    <input type="text" name="title" class="form-control"
                                           id="inputTitle" aria-describedby="text" required="true"/>
                                </div>
                                <div class="mb-4">
                                    <label for="inputDescription" class="form-label">Issue Description</label>
                                    <textarea name="description" class="form-control" id="inputDescription"
                                           style="min-height: 10rem;font-weight: 500;" aria-describedby="text"/>
                                </div>
                                <div class="mb-4">
                                  <label for="inputFiles" class="form-label">Attached files</label>
                                  <input class="form-control" name="files" type="file" id="inputFiles" accept="image/*, .txt"
                                         multiple="true" aria-describedby="inputFilesHelp"/>
                                    <div id="inputFilesHelp" class="form-text" style="font-size:.95rem;">
                                        Only .txt files and images are allowed.</div>
                                </div>
                                <div class="mb-4 form-check">
                                    <input type="checkbox" class="form-check-input" id="cbPrivacyPolicy" required="true"/>
                                    <label class="form-check-label" for="cbPrivacyPolicy">
                                        Accept our privacy and policy.*
                                    </label>
                                    <a href="https://www.neokingdom.org/privacy-policy">(Read)</a>
                                </div>
                                <button type="submit" class="btn btn-primary issue-btn w-semibold">
                                    Submit
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="row justify-content-center">
                        <div class="col-12 footer text-center">

                            <div class="social-container">
                                <div>
                                    <a href="https://www.neokingdom.org" target="_new">NEOKingdom DAO</a>
                                </div>
                                <div>
                                    <a href="https://twitter.com/NEOKingdomDAO" target="_new">Twitter</a>
                                </div>
                                <div>
                                    <a href="https://www.linkedin.com/company/neokingdomdao" target="_new">LinkedIn</a>
                                </div>
                                <div>
                                    <a href="https://discord.com/invite/Fb63MbqFFe" target="_new">Discord</a>
                                </div>
                                <div>
                                    <a href="mailto:info@neokingdom.org" target="_new">info@neokingdom.org</a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <script src="/neok_bug_submission/static/src/js/issue_page.js"/>
                <script t-att-src="'https://www.google.com/recaptcha/api.js?render=' + recaptcha_site_key"></script>
            </div>
        </t>
    </template>

    <template id="issue_page_response" name="Issue Page Response">
        <t t-call="web.layout">
            <t t-set="title">Report Issue</t>

            <t t-set="head_web">
                <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
                <!-- Chrome, Firefox OS and Opera -->
                <meta name="theme-color" content="#f01363"/>
                <link rel="icon" sizes="192x192" href="/web/static/img/mobile-icons/android-192x192.png"/>

                <!-- iOS Safari -->
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
                <link rel="apple-touch-icon" href="/web/static/img/mobile-icons/apple-152x152.png"/>

                <!-- Windows Phone -->
                <meta name="msapplication-navbutton-color" content="#875A7B"/>
                <meta name="msapplication-TileColor" content="#875A7B"/>
                <meta name="msapplication-TileImage" content="/web/static/img/mobile-icons/windows-144x144.png"/>
            </t>
            <t t-set="head" t-value="head_web + (head or '')"/>

            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
                  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
                  crossorigin="anonymous"/>
            <link href="/neok_bug_submission/static/src/css/issue_page.css" rel="stylesheet"/>


            <div class="issue-page-container">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-12 title text-center">
                            <img src="/neok_bug_submission/static/src/img/neok_logo.png" alt="NEOKingdom Logo"/>
                            <h1 t-esc="res_title"/>
                            <h2 t-esc="res_subtitle"/>
                        </div>
                    </div>
                    <div class="row justify-content-center body-container">
                        <div class="col-12 report-bug-response-body text-center my-5">
                            <p t-esc="msg"/>
                            <t t-if="not success">
                                <a href="/issue"
                                   class="mt-2 issue-btn btn btn-lg btn-lg btn-primary fw-semibold">
                                    Retry
                                </a>
                            </t>
                        </div>
                    </div>
                    <div class="row justify-content-center">
                        <div class="col-12 footer text-center">

                            <div class="social-container">
                                <div>
                                    <a href="https://www.neokingdom.org" target="_new">NEOKingdom DAO</a>
                                </div>
                                <div>
                                    <a href="https://twitter.com/NEOKingdomDAO" target="_new">Twitter</a>
                                </div>
                                <div>
                                    <a href="https://www.linkedin.com/company/neokingdomdao" target="_new">LinkedIn</a>
                                </div>
                                <div>
                                    <a href="https://discord.com/invite/Fb63MbqFFe" target="_new">Discord</a>
                                </div>
                                <div>
                                    <a href="mailto:info@neokingdom.org" target="_new">info@neokingdom.org</a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>