<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Re-Creating search view to show filters that NEOKingdom needs -->
    <record id="view_task_search_form" model="ir.ui.view">
        <field name="name">neokingdom.project.task.search.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <xpath expr="//search" position="replace">
                <search string="Tasks">
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('id', 'ilike', self)]"/>
                    <field name="tag_ids"/>
                    <field name="user_ids" invisible="1"/>
                    <field name="contributing_users" filter_domain="[('contributing_users.name', 'ilike', self), ('contributing_users.active', 'in', [True, False])]"/>
                    <field name="approval_user_id" string="Controller" filter_domain="[('approval_user_id.name', 'ilike', self)]"/>
                    <field name="project_id"/>
                    <field name="description"/>
                    <filter string="Assignees" name="user" context="{'group_by': 'user_ids'}" invisible="1"/>
                    <filter string="Open Tasks" name="open_tasks" domain="[('is_closed', '=', False)]" invisible="1"/>
                    <filter string="My Tasks" name="my_tasks" domain="[('contributing_users', 'in', [uid])]"/>
                    <filter string="Future Activities" name="activities_upcoming_all"
                            domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter string="Unassigned" name="unassigned" domain="[('user_ids', '=', False)]"/>
                    <filter string="Blocked" name="blocked" domain="[('is_blocked', '=', True)]" groups="project.group_project_task_dependencies"/>
                    <filter string="Blocking" name="blocking"
                            domain="[('is_closed', '=', False), ('dependent_ids', '!=', False)]"
                            groups="project.group_project_task_dependencies"/>
                    <separator/>
                    <filter string="Circle: Outreach" name="neok_circle_outreach" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_outreach)d])]"/>
                    <filter string="Circle: Office" name="neok_circle_office" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_office)d])]"/>
                    <filter string="Circle: Recruiting / HR" name="neok_circle_recruiting_hr" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_recruiting_hr)d])]"/>
                    <filter string="Circle: Odoo" name="neok_circle_odoo" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_odoo)d])]"/>
                    <filter string="Circle: Dapp" name="neok_circle_dapp" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_dapp)d])]"/>
                    <filter string="Circle: Smart Contracts" name="neok_circle_smart_contracts" domain="[('id', 'in', [%(neok_project_management.neok_circle_smart_contracts)d])]"/>
                    <filter string="Circle: Design" name="neok_circle_design" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_design)d])]"/>
                    <filter string="Circle: BizDev" name="neok_circle_bizdev" domain="[('tag_ids', 'in', [%(neok_project_management.neok_circle_bizdev)d])]"/>
                    <separator/>
                    <filter name="create_date" date="create_date"/>
                    <filter name="date_deadline" date="date_deadline"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Tag" name="tag" context="{'group_by': 'tag_ids'}"/>
                        <filter string="Stage" name="stage" context="{'group_by': 'stage_id'}"/>
                        <filter string="Controller" name="approval_user_id" context="{'group_by': 'approval_user_id'}"/>
                        <separator/>
                        <filter string="Parent Task" name="groupby_ancestor_task"
                                context="{'group_by': 'ancestor_id'}" groups="project.group_subtask_project"/>
                        <filter string="Project" name="project_id" context="{'group_by': 'project_id'}"/>
                    </group>
                </search>
            </xpath>

        </field>
    </record>

</odoo>